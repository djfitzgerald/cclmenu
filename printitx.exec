/*
 * PRINTITX
 *    Print spool files generated by the CCLPRINT EXEC
 *
 * Classification:
 *      Public
 *
 * Author:
 *      Dan FitzGerald <danjfitzgerald@comcast.net>
 *
 * Revision History:
 *    10/2026
 *      - Version 1.100
 *      - Initial release
 *
 * Purpose:
 *    CCLPRINT EXEC (part of the CCLMENU application) has the ability
 *    to send print jobs to the system operator's reader for later
 *    printing.  The idea is that at a large conference there could be
 *    contention on the line printer and that this would let the system
 *    operator run all of such queued print jobs at once at the end of
 *    the day or when the exhibit has light attendance.
 *
 *    This application allows the system operator to start printing
 *    the jobs and walk away.
 *
 * Usage:
 *
 *    >>--PRINTITX----------------------------------------------->
 *
 * Exit Normal -
 *      RC =  0 - Operation completed successfully
 *
 * Exit Error -
 *      None
 */

ADDRESS CMS
TRACE OFF

/* Global data members */
spoolFilesToPrint.0 = 0

ADDRESS COMMAND 'PIPE (ENDCHAR ?)',
,
,/* Erase any CCLPRINT LISTING files on our A disk */
'     CMS ERASE CCLPRINT LISTING A | HOLE',
,
,/* Get a list of all spool files in the reader */
'?    CP Q RDR USERID *',
'|    DROP FIRST 1',
,
,/* Get detailed information for each spool file */
'|    SPECS',
       '/CALLPIPE (STAGESEP ¦)/ 1',
       '/   CP Q RDR USERID */ NEXT W2 NEXTW /ALL/ NEXTW',
       '/ ¦ DROP FIRST 1/ NEXT',
       '/ ¦*:/ NEXT',
'|    PIPCMD',
,
,/* Isolate only those files named CCLPRINT LISTING */
'|    LOCATE 54-70 /CCLPRINT  LISTING/',
'|    SPECS W2 1',
'|    STEM spoolFilesToPrint.'

/*
 * For each of the spool files generated by CCLPRINT,
 * download the file, send it to the printer, then
 * erase it
 */
DO i = 1 TO spoolFilesToPrint.0
   spoolid = spoolFilesToPrint.i
   'RECEIVE' spoolid 'CCLPRINT LISTING A (REPL'
   'PRINT CCLPRINT LISTING A'
   'ERASE CCLPRINT LISTING A'
END

EXIT 0
