100 REM
110 REM     ELIZA/DOCTOR
120 REM     CREATED BY JOSEPH WEIZENBAUM
130 REM     THIS VERSION BY JEFF SHRAGER
140 REM     EDITIED AND MODIFIED FOR MITS 8K BASIC 4.0 BY STEVE NORTH
150 REM     CREATIVE COMPUTING PO BOX 789-M MORRISTOWN NJ 07960
160 REM     SEE CREATIVE COMPUTING VOL. 4 NO. 3, JULY/AUGUST 1977
170 REM     ----------------------------------------------------------
180 REM     MODIFIED FOR IBM BASIC/VM BY EVIE COOPER & DAN FITZGERALD
190 REM     WITH DEBUGGING ASSISTANCE FROM BERNIE MICHALIK AND IBM BOB
200 REM     JULY 2025 - OCTOBER 2026
210 REM     ----------------------------------------------------------
220 REM     -----INITIALIZATION-----
230 DIM C$, I$, K$, F$, S$, R$, P$, Z$
240 DIM S(36), R(36), N(36)
250 N1 = 36
260 N2 = 12
270 N3 = 112
280 FOR X = 1 TO N1 + N2 + N3 : REM LOAD DATA IN FROM MEMORY
290  READ Z$
300 NEXT X
310 FOR X = 1 TO N1
320  READ S(X), L
330  R(X) = S(X)
340  N(X) = S(X) + L - 1
350 NEXT X
360 REM
370 REM     -----OPEN TRANSCRIPT FILE-----
380 OPEN #1: "ELIZA $LOG$ A", ACCESS OUTPUT, &
  &                           TYPE DISPLAY, &
  &                           ORGANIZATION SEQUENTIAL
390 PRINT #1: "---------------ELIZA SESSION TRANSCRIPT---------------"
400 PRINT #1: ""
410 REM
420 REM     -----PROGRAM GREETING-----
430 PRINT "HI!  I'M ELIZA.  WHAT'S YOUR PROBLEM?"
440 PRINT #1: "ELIZA: HI!  I'M ELIZA.  WHAT'S YOUR PROBLEM?"
450 REM
460 REM     -----USER INPUT SECTION-----
470 REM
480 LINPUT I$ : REM USE LINPUT SO WE DON'T BARF ON COMMAS AND SUCH
490 I$ = UPRC$(I$) : REM CONVERT INPUT TO UPPERCASE
500 PRINT #1: "  YOU:    "; I$
510 I$=" " & I$ & " "
520 REM  GET RID OF APOSTROPHES
530 FOR L = 1 TO LEN(I$)
540  IF I$(L:L) = "'" THEN
550   I$ = I$(1:L-1) & I$(L+1 : LEN(I$))
560   GOTO 540
570  END IF
580  IF L + 4 <= LEN(I$) THEN
590   IF I$(L:8) = "SHUT UP" THEN
600    PRINT "SHUT UP..."
610    GOTO 2740
620   END IF
630  END IF
640 NEXT L
650 IF I$ = P$ THEN
660  PRINT "PLEASE DON'T REPEAT YOURSELF!"
670  PRINT #1: "ELIZA: PLEASE DON'T REPEAT YOURSELF!"
680  GOTO 450
690 END IF
700 REM
710 REM     -----FIND KEYWORD IN I$-----
720 REM
730 RESTORE
740 S1 = 0
750 FOR K = 1 TO N1
760  READ K$
770  IF S1 > 0 THEN GOTO 850
780  FOR L = 1 TO LEN(I$) - LEN(K$) + 1
790   IF I$(L : L+LEN(K$)-1) = K$ THEN
800    S1 = K
810    T = L
820    F$ = K$
830   END IF
840  NEXT L
850 NEXT K
860 IF S1 > 0 THEN
870  K = S1
880  L = T
890  GOTO 960
900 END IF
910 K = 36 : GOTO 1210 : REM  WE DIDN'T FIND ANY KEYWORDS
920 REM
930 REM     TAKE RIGHT PART OF STRING AND CONJUGATE IT
940 REM     USING THE LIST OF STRINGS TO BE SWAPPED
950 REM
960 RESTORE
970 FOR X = 1 TO N1
980 READ Z$
990 NEXT X
1000 REM SKIP OVER KEYWORDS
1010 C$=" " & I$(L+LEN(F$) : LEN(I$))
1020 FOR X = 1 TO N2/2
1030  READ S$, R$
1040  FOR L = 1 TO LEN(C$)
1050   IF L + LEN(S$) > LEN(C$) THEN GOTO 1100
1060   IF C$(L:LEN(S$)) <> S$ THEN GOTO 1100
1070   C$ = C$(1 : L-1) & R$ & C$(LEN(C$)-L-LEN(S$)+1:LEN(C$))
1080   L = L + LEN(R$)
1090   GOTO 1140
1100   IF L + LEN(R$) > LEN(C$) THEN GOTO 1140
1110   IF C$(L:LEN(R$)) <> R$ THEN GOTO 1140
1120   C$ = C$(1:L - 1) & S$ & C$(LEN(C$)-L-LEN(R$)+1:LEN(C$))
1130   L = L + LEN(S$)
1140  NEXT L
1150 NEXT X
1160 REM ENSURE WE HAVE ONLY 1 LEADING SPACE:
1170 IF C$(2:2) = " " THEN C$ = C$(2 : LEN(C$))
1180  REM
1190  REM     NOW USING THE KEYWORD NUMBER (K) GET REPLY
1200  REM
1210  RESTORE
1220 FOR X = 1 TO N1 + N2 : READ Z$ : NEXT X
1230 FOR X = 1 TO R(K) : READ F$ : NEXT X : REM READ RIGHT REPLY
1240 R(K) = R(K) + 1
1250 IF R(K) > N(K) THEN R(K) = S(K)
1260 IF F$(LEN(F$) : LEN(F$)) <> "*" THEN
1270  PRINT F$
1280  PRINT #1: "ELIZA: "; F$
1290  P$=I$
1300  GOTO 450
1310 END IF
1320 PRINT F$(1:LEN(F$) - 1); C$
1330 PRINT #1: "ELIZA: "; F$(1:LEN(F$) - 1); C$
1340 P$ = I$
1350 GOTO 450
1360 REM
1370 REM     -----PROGRAM DATA FOLLOWS-----
1380 REM
1390 REM     KEYWORDS
1400 REM
1410 DATA "CAN YOU","CAN I","YOU ARE","YOURE","I DONT","I FEEL"
1420 DATA "WHY DONT YOU","WHY CANT I","ARE YOU","I CANT","I AM","IM "
1430 DATA "YOU ","I WANT","WHAT","HOW","WHO","WHERE","WHEN","WHY"
1440 DATA "NAME","CAUSE","SORRY","DREAM","HELLO","HI ","MAYBE"
1450 DATA " NO","YOUR","ALWAYS","THINK","ALIKE","YES","FRIEND"
1460 DATA "COMPUTER","NOKEYFOUND"
1470 REM
1480 REM     STRING DATA FOR CONJUGATIONS
1490 REM
1500 DATA " ARE "," AM ","WERE ","WAS "," YOU "," I ","YOUR ","MY "
1510 DATA " IVE "," YOUVE "," IM "," YOURE "
1520 REM
1530 REM     REPLIES
1540 REM
1550 DATA "DON'T YOU BELIEVE THAT I CAN*"
1560 DATA "PERHAPS YOU WOULD LIKE TO BE ABLE TO*"
1570 DATA "YOU WANT ME TO BE ABLE TO*"
1580 DATA "PERHAPS YOU DON'T WANT TO*"
1590 DATA "DO YOU WANT TO BE ABLE TO*"
1600 DATA "WHAT MAKES YOU THINK I AM*"
1610 DATA "DOES IT PLEASE YOU TO BELIEVE I AM*"
1620 DATA "PERHAPS YOU WOULD LIKE TO BE*"
1630 DATA "DO YOU SOMETIMES WISH YOU WERE*"
1640 DATA "DON'T YOU REALLY*"
1650 DATA "WHY DON'T YOU*"
1660 DATA "DO YOU WISH TO BE ABLE TO*"
1670 DATA "DOES THAT TROUBLE YOU?"
1680 DATA "TELL ME MORE ABOUT SUCH FEELINGS."
1690 DATA "DO YOU OFTEN FEEL*"
1700 DATA "DO YOU ENJOY FEELING*"
1710 DATA "DO YOU REALLY BELIEVE I DON'T*"
1720 DATA "PERHAPS IN GOOD TIME I WILL*"
1730 DATA "DO YOU WANT ME TO*"
1740 DATA "DO YOU THINK YOU SHOULD BE ABLE TO*"
