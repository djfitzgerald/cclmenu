2670 REM
2680 REM     DATA FOR FINDING RIGHT REPLIES
2690 REM
2700 DATA 1,3,4,2,6,4,6,4,10,4,14,3,17,3,20,2,22,3,25,3
2710 DATA 28,4,28,4,32,3,35,5,40,9,40,9,40,9,40,9,40,9,40,9
2720 DATA 49,2,51,4,55,4,59,4,63,1,63,1,64,5,69,5,74,2,76,4
2730 DATA 80,3,83,7,90,3,93,6,99,7,106,6
2740 PRINT #1: ""
2750 PRINT #1: "-----------------END OF ELIZA SESSION-----------------"
2760 CLOSE #1
2770 END
